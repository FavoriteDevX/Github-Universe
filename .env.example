# Optional: real MVC token on a TESTNET (Base Sepolia or Polygon Amoy).
# Copy to .env and fill in. Without these values the game keeps in-game coins only.
# Create the keys at https://thirdweb.com/dashboard (Project -> Settings).
THIRDWEB_CLIENT_ID=
THIRDWEB_SECRET_KEY=
# base-sepolia (default) or polygon-amoy. Mainnets are refused on purpose.
MVC_CHAIN=base-sepolia
# ERC-20 address: thirdweb "Token" template (MVC_MINT_METHOD=mintTo) or
# blockchain/contracts/MVCToken.sol (MVC_MINT_METHOD=mint)
MVC_TOKEN_ADDRESS=
MVC_MINT_METHOD=mintTo
# Admin wallet that can mint (MINTER_ROLE on the thirdweb template, owner or
# game contract on MVCToken). Use a wallet made only for this game, never your personal one.
GAME_ADMIN_PRIVATE_KEY=
# Wallet that receives MVC paid for land (defaults to the admin wallet)
GAME_TREASURY_ADDRESS=
# Most MVC one claim can mint
MVC_MAX_CLAIM=500
# Optional custom RPC URL for the same testnet
MVC_RPC_URL=
